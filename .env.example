# ============================================================
# ShareSwap - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# -----------------------------------------------------------
# WalletConnect Project ID
# Get from: https://cloud.walletconnect.com
# -----------------------------------------------------------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# -----------------------------------------------------------
# ARC App Kit (Circle Console)
# Get from: https://console.circle.com
# Required for Swap functionality
# -----------------------------------------------------------
NEXT_PUBLIC_ARC_KIT_KEY=your_arc_app_kit_key_here

# -----------------------------------------------------------
# ARC Testnet RPC
# Default public endpoint provided — replace for production
# -----------------------------------------------------------
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network

# -----------------------------------------------------------
# NFT Smart Contract Address
# Deploy contracts/ShareSwapNFT.sol and paste address here
# -----------------------------------------------------------
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# -----------------------------------------------------------
# IPFS / Pinata (NFT metadata upload)
# Get from: https://pinata.cloud
# -----------------------------------------------------------
NEXT_PUBLIC_PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_key_here
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud

# -----------------------------------------------------------
# App Config
# -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_EXPLORER_URL=https://testnet.arcscan.net
