{
  "framework": "nextjs",
  "buildCommand": "npm install --omit=optional && npm run build",
  "installCommand": "npm install --omit=optional",
  "outputDirectory": ".next",
  "env": {
    "NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID": "@walletconnect_project_id",
    "NEXT_PUBLIC_ARC_KIT_KEY": "@arc_kit_key",
    "NEXT_PUBLIC_ARC_RPC_URL": "https://rpc.testnet.arc.network",
    "NEXT_PUBLIC_EXPLORER_URL": "https://testnet.arcscan.net",
    "NEXT_PUBLIC_NFT_CONTRACT_ADDRESS": "@nft_contract_address",
    "NEXT_PUBLIC_PINATA_API_KEY": "@pinata_api_key",
    "NEXT_PUBLIC_APP_URL": "@app_url"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
